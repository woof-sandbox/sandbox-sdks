  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.3.0+sha512.ee592eda8815a8a293c206bb0917c4bb0ff274c50def7cbc17be05ec641fc2d1b02490ce660061356bd0d126a4d7eb2ec8830e6959fb8a447571c631d5a2442d",
  "homepage": "https://github.com/woof-compound/sandbox-sdks#readme",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woof-compound/sandbox-sdks.git"
  },
  "bugs": {
    "url": "https://github.com/woof-compound/sandbox-sdks/issues"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check && $npm_execpath lint:address",
