    "test": "dotenv -- vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^3.0.5",
    "dotenv-cli": "^8.0.0",
    "ethers": "^6.13.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "keywords": ["sandbox", "sdk", "compound"]
}
