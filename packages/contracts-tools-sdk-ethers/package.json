{
  "name": "@sandbox/contracts-tools-sdk-ethers",
  "description": "Module simplify smart contract interactions and multicall3 aggregation on the Ethereum blockchain and other EVM-compatible networks.",
  "version": "1.0.0",
  "license": "MIT",
  "main": "src/index.ts",
  "type": "module",
  "keywords": ["local", "library", "npm"],
  "files": ["lib"],
  "scripts": {
    "prepublish": "$npm_execpath build",
    "build": "tsc --build  tsconfig.build.json",
    "test": "vitest run --coverage --config test/vitest-config/vitest.config.unit.ts",
    "test:unit": "vitest run --coverage --config test/vitest-config/vitest.config.unit.ts",
    "test:e2e": "vitest run --coverage --config test/vitest-config/vitest.config.e2e.ts",
    "test:local": "vitest run --coverage --config test/vitest-config/vitest.config.local.ts",
    "test:all": "vitest run --coverage --config test/vitest-config/vitest.config.all.ts"
  },
  "peerDependencies": {
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "ethers": "^6.13.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts"
  }
}
