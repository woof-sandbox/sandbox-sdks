{
  "name": "@sandbox/comet-sdk-wagmi",
  "description": "Wagmi-based augmentation of `@sandbox/comet-sdk` that exports (and optionally injects) wagmi-based fetch methods.",
  "version": "0.0.1",
  "license": "MIT",
  "main": "src/index.ts",
  "type": "module",
  "files": ["lib"],
  "scripts": {
    "prepublish": "$npm_execpath build",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run --coverage --config test/vitest-config/vitest.config.unit.ts",
    "test:unit": "vitest run --coverage --config test/vitest-config/vitest.config.unit.ts",
    "test:e2e": "vitest run --coverage --config test/vitest-config/vitest.config.e2e.ts",
    "test:all": "vitest run --coverage --config test/vitest-config/vitest.config.all.ts"
  },
  "peerDependencies": {
    "@sandbox/comet-sdk": "workspace:^",
    "@sandbox/subgraph-sdk": "workspace:^",
    "@wagmi/core": "^2.16.7",
    "viem": "2.x"
  },
  "devDependencies": {
    "@sandbox/comet-sdk": "workspace:^",
    "@sandbox/subgraph-sdk": "workspace:^",
    "@wagmi/core": "^2.16.7",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts"
  }
}
