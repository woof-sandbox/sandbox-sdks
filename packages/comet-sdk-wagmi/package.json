{
  "name": "@woof-software/comet-sdk-wagmi",
  "description": "Wagmi-based augmentation of `@woof-software/comet-sdk` that exports (and optionally injects) wagmi-based fetch methods.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woof-compound/sandbox-sdks.git"
  },
  "homepage": "https://github.com/woof-compound/sandbox-sdks#readme",
  "bugs": {
    "url": "https://github.com/woof-compound/sandbox-sdks/issues"
  },
  "license": "MIT",
  "main": "src/index.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "scripts": {
    "prepublish": "$npm_execpath build",
    "build": "tsc --build tsconfig.build.json --force && node ../../scripts/compile/post-compile.js",
    "test": "vitest run --coverage --config test/vitest-config/vitest.config.unit.ts",
    "test:unit": "vitest run --coverage --config test/vitest-config/vitest.config.unit.ts",
    "test:e2e": "vitest run --coverage --config test/vitest-config/vitest.config.e2e.ts",
    "test:all": "vitest run --coverage --config test/vitest-config/vitest.config.all.ts"
  },
  "peerDependencies": {
    "@wagmi/core": "^2.16.7",
    "@woof-software/comet-sdk": "workspace:^",
    "@woof-software/subgraph-sdk": "workspace:^",
    "viem": "2.x"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "access": "public"
  }
}
